# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/natasekolah_dev?schema=public"

# Session
# TIDAK ADA SESSION_SECRET — dan memang tidak diperlukan.
# Token sesi adalah token acak 256-bit yang hanya disimpan sebagai hash SHA-256
# di database (src/lib/auth/session.ts), sehingga tidak ada tanda tangan
# kriptografis yang butuh rahasia. Cookie memakai HttpOnly + Secure (production) +
# SameSite=Lax + prefix __Host- (src/lib/auth/cookie).
# Var lama SESSION_SECRET dihapus dari contoh ini karena tidak pernah dibaca
# oleh kode mana pun (audit 2026-10-01).

# Cron API (opsional) — mengamankan endpoint /api/cron/*.
# Bila di-set, request wajib menyertakan header: Authorization: Bearer ***
# CRON_SECRET=""

# AI Question Generator (Phase 7 Trek C) — konfigurasi provider
# Pilih SATU provider: OPENAI_API_KEY | ANTHROPIC_API_KEY | GEMINI_API_KEY
# AI_PROVIDER="openai"
# OPENAI_API_KEY="sk-..."
# ANTHROPIC_API_KEY="sk-ant-..."
# GEMINI_API_KEY="..."
# AI_MODEL_DEFAULT="gpt-4o-mini"
# AI_GENERATION_DAILY_LIMIT=30
# AI_GENERATION_COOLDOWN_SECONDS=15

# AI Generator Runtime (Phase 8) — Environment Variables
# AI_PROVIDER=openai          # openai | anthropic | gemini | local
# AI_API_KEY=sk-...           # API key provider (dummy untuk local)
# AI_MODEL=gpt-4o-mini        # Model yang dipakai
# AI_DAILY_QUOTA_PER_TEACHER=30
# AI_COOLDOWN_MS=15000
# AI_GENERATION_ENABLED=false  # Default: false (flag wajib diaktifkan per institusi)
# AI_LOCAL_BASE_URL=http://localhost:11434  # Hanya untuk provider local (Ollama/vLLM)

# Rate Limit Production (Phase 11.4 Optional) — Upstash Redis (HTTP REST)
# RATE_LIMIT_REDIS_URL=https://xxx.upstash.io  # Upstash REST URL
# RATE_LIMIT_REDIS_TOKEN=xxx                   # Upstash REST token

# Cohere API (Phase 11.5 Optional) — Semantic Search & Rerank untuk DKAS Bot
# Free tier: 1M requests/bulan
# COHERE_API_KEY=xxx
# COHERE_BASE_URL=https://api.cohere.com/v2  # Optional, default ke Cohere cloud

# Observability (Phase 12.6) — Logger terstruktur Pino + metrik in-memory
# LOG_LEVEL=info               # trace | debug | info | warn | error | fatal | silent
#                               # (default: info; otomatis "silent" saat NODE_ENV=test)
# LOG_FORMAT=json              # paksa JSON mentah; tanpa ini dev memakai format
#                               # ringkas satu baris (prod SELALU JSON)
# Metrik kustom tercatat di memori per proses: ai_generation_latency_ms,
# search_fallback_cohere_count, rate_limit_hits (lihat src/lib/observability/).
