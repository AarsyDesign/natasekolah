datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// -------------------------------------------------------------
// PHASE 0 — MULTI-TENANCY & FOUNDATION SCHEMA
// -------------------------------------------------------------

// Tenant Root Entity
model Institution {
  id              String         @id @default(cuid())
  name            String
  slug            String         @unique
  type            String         @default("SEKOLAH") // SEKOLAH | PESANTREN | PESANTREN_TERPADU | RUMAH_TAHFIDZ | PKBM
  enabledPlugins  String         @default("[\"FORMAL_ACADEMIC\"]") // JSON Array
  address         String?
  phone           String?
  logoUrl         String?
  settingsJson    String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  // Tenant-Scoped Core Relations
  users               User[]
  academicYears       AcademicYear[]
  classrooms          Classroom[]
  students            Student[]
  enrollments         Enrollment[]
  subjects            Subject[]
  teacherAssignments  TeacherAssignment[]
  guardians           Guardian[]
  guardianStudents    GuardianStudent[]
  guardianInvitations GuardianInvitation[]
  sessions            Session[]
  auditLogs           AuditLog[]
  attendanceSessions  AttendanceSession[]
  attendanceRecords   AttendanceRecord[]
  notificationOutbox  NotificationOutbox[]
  feeCategories       FeeCategory[]
  studentCharges      StudentCharge[]
  paymentTransactions PaymentTransaction[]
  paymentAllocations  PaymentAllocation[]
  cashbookEntries     CashbookEntry[]
  receipts            Receipt[]
  assessments         Assessment[]
  assessmentScores    AssessmentScore[]
  reportCards         ReportCard[]
  reportCardSubjects  ReportCardSubject[]
  tahfidzRecords      TahfidzRecord[]
  dormitories         Dormitory[]
  dormitoryRooms      DormitoryRoom[]
  dormitoryAssignments StudentDormitoryAssignment[]

  @@index([slug])
  @@index([type])
}

// Tenant-Scoped User & Staff
model User {
  id              String         @id @default(cuid())
  institutionId   String
  name            String
  email           String
  phoneWa         String?
  passwordHash    String
  roles           String         @default("[\"STAFF\"]") // JSON: SUPER_ADMIN, INSTITUTION_ADMIN, TEACHER, TREASURER, etc.
  isActive        Boolean        @default(true)
  lastLoginAt     DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  institution         Institution         @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  sessions            Session[]
  auditLogs           AuditLog[]
  teacherAssignments  TeacherAssignment[]
  receivedPayments    PaymentTransaction[]
  createdCashbookEntries CashbookEntry[]
  issuedReceipts      Receipt[]
  publishedReportCards ReportCard[]
  recordedTahfidz     TahfidzRecord[]

  @@unique([id, institutionId])
  @@unique([institutionId, email])
  @@index([institutionId, isActive])
}

// Academic Period
model AcademicYear {
  id              String         @id @default(cuid())
  institutionId   String
  name            String         // e.g. "2025/2026"
  isActive        Boolean        @default(false)
  startDate       DateTime?
  endDate         DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  institution         Institution         @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  classrooms          Classroom[]
  enrollments         Enrollment[]
  teacherAssignments  TeacherAssignment[]
  studentCharges      StudentCharge[]
  reportCards         ReportCard[]

  @@unique([id, institutionId])
  @@unique([institutionId, name])
  @@index([institutionId, isActive])
}

// Classroom / Rombel
model Classroom {
  id              String         @id @default(cuid())
  institutionId   String
  academicYearId  String
  name            String         // e.g. "Kelas 7A", "Halaqah Ula"
  gradeLevel      String?        // "7", "8", "Ula", "Wustha"
  capacity        Int?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  institution         Institution         @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  academicYear        AcademicYear        @relation(fields: [academicYearId, institutionId], references: [id, institutionId], onDelete: Cascade)
  enrollments         Enrollment[]
  teacherAssignments  TeacherAssignment[]
  reportCards         ReportCard[]

  @@unique([id, institutionId])
  @@unique([id, academicYearId, institutionId])
  @@unique([institutionId, academicYearId, name])
  @@index([institutionId, academicYearId])
}

// Student Master Entity
model Student {
  id              String         @id @default(cuid())
  institutionId   String
  nis             String
  nisn            String?
  nik             String?
  fullName        String
  nickname        String?
  gender          String         @default("L") // L | P
  birthPlace      String?
  birthDate       DateTime?
  religion        String?
  address         String?
  phone           String?
  email           String?
  status          String         @default("ACTIVE") // ACTIVE | INACTIVE | GRADUATED | TRANSFERRED | ALUMNI
  parentWaPhone   String?        // Legacy fallback
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  institution     Institution    @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  enrollments     Enrollment[]
  guardians       GuardianStudent[]
  attendanceRecords AttendanceRecord[]
  charges         StudentCharge[]
  payments        PaymentTransaction[]
  assessmentScores AssessmentScore[]
  reportCards     ReportCard[]
  tahfidzRecords  TahfidzRecord[]
  dormitoryAssignments StudentDormitoryAssignment[]

  @@unique([id, institutionId])
  @@unique([institutionId, nis])
  @@index([institutionId, status])
  @@index([institutionId, fullName])
  @@index([institutionId, nisn])
}

// Sacred History: Enrollment Engine
model Enrollment {
  id              String         @id @default(cuid())
  institutionId   String
  studentId       String
  academicYearId  String
  classroomId     String
  status          String         @default("ENROLLED") // ENROLLED | PROMOTED | RETAINED | GRADUATED | TRANSFERRED
  enrolledAt      DateTime       @default(now())
  endedAt         DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  institution     Institution    @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  student         Student        @relation(fields: [studentId, institutionId], references: [id, institutionId], onDelete: Cascade)
  academicYear    AcademicYear   @relation(fields: [academicYearId, institutionId], references: [id, institutionId], onDelete: Cascade)
  classroom       Classroom      @relation(fields: [classroomId, academicYearId, institutionId], references: [id, academicYearId, institutionId], onDelete: Cascade)
  attendanceRecords AttendanceRecord[]
  assessmentScores AssessmentScore[]
  reportCards     ReportCard[]
  tahfidzRecords  TahfidzRecord[]

  // 1 siswa hanya memiliki 1 rekaman rombel per tahun ajaran
  @@unique([studentId, academicYearId])
  @@unique([id, institutionId])
  @@index([institutionId, academicYearId, classroomId])
  @@index([institutionId, status])
}

// Tenant Audit Trail
model AuditLog {
  id              String         @id @default(cuid())
  institutionId   String
  userId          String?
  action          String         // CREATE | UPDATE | DELETE | LOGIN | IMPERSONATE | EXPORT
  entityType      String         // User | Student | Classroom | Enrollment | Institution
  entityId        String?
  detailsJson     String?
  ipAddress       String?
  createdAt       DateTime       @default(now())

  institution     Institution    @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  user            User?          @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([institutionId, createdAt])
  @@index([institutionId, entityType, entityId])
}

// Tenant-Scoped Authenticated Session (Unified for Staff and Guardian)
model Session {
  id             String       @id @default(cuid())
  tokenHash      String       @unique
  subjectType    String       @default("INTERNAL_USER") // INTERNAL_USER | GUARDIAN
  userId         String?
  guardianId     String?
  institutionId  String
  expiresAt      DateTime
  revokedAt      DateTime?
  lastUsedAt     DateTime     @default(now())
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime     @default(now())

  user           User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  guardian       Guardian?    @relation(fields: [guardianId], references: [id], onDelete: Cascade)
  institution    Institution  @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@index([userId])
  @@index([guardianId])
  @@index([institutionId])
  @@index([expiresAt])
  @@map("sessions")
}

// Institution-Scoped Guardian Identity
model Guardian {
  id              String               @id @default(cuid())
  institutionId   String
  fullName        String
  phoneWa         String
  email           String?
  status          String               @default("INVITED") // INVITED | ACTIVE | INACTIVE
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  institution     Institution          @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  students        GuardianStudent[]
  invitations     GuardianInvitation[]
  sessions        Session[]

  @@unique([id, institutionId])
  @@index([institutionId, phoneWa])
  @@index([institutionId, status])
  @@map("guardians")
}

// Relationship Access: Guardian to Student (Cross-Tenant Relational Integrity enforced by Compound FKs)
model GuardianStudent {
  id            String      @id @default(cuid())
  institutionId String
  guardianId    String
  studentId     String
  relationship  String      // AYAH | IBU | WALI | LAINNYA
  isPrimary     Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  guardian      Guardian    @relation(fields: [guardianId, institutionId], references: [id, institutionId], onDelete: Cascade)
  student       Student     @relation(fields: [studentId, institutionId], references: [id, institutionId], onDelete: Cascade)
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  @@unique([guardianId, studentId])
  @@index([institutionId, studentId])
  @@index([institutionId, guardianId])
  @@map("guardian_students")
}

// Ephemeral One-Time Guardian Onboarding Invitation
model GuardianInvitation {
  id            String      @id @default(cuid())
  tokenHash     String      @unique
  guardianId    String
  institutionId String
  expiresAt     DateTime
  redeemedAt    DateTime?
  sentVia       String      @default("WHATSAPP") // WHATSAPP | SMS | MANUAL
  createdById   String?
  createdAt     DateTime    @default(now())

  guardian      Guardian    @relation(fields: [guardianId, institutionId], references: [id, institutionId], onDelete: Cascade)
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@index([guardianId, expiresAt])
  @@index([institutionId])
  @@map("guardian_invitations")
}

// -------------------------------------------------------------
// PHASE 2 — ACADEMIC TEACHING CORE
// -------------------------------------------------------------

// Subject / Mata Pelajaran
model Subject {
  id              String         @id @default(cuid())
  institutionId   String
  code            String?        // e.g. "MAT", "BIND", "PAI"
  name            String         // e.g. "Matematika", "Bahasa Indonesia"
  shortName       String?        // e.g. "MTK", "BIN"
  category        String?        // "UMUM" | "AGAMA" | "MULOK" | "PEMINATAN"
  isActive        Boolean        @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  institution         Institution         @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  teacherAssignments  TeacherAssignment[]
  reportCardSubjects  ReportCardSubject[]

  @@unique([id, institutionId])
  @@unique([institutionId, code])
  @@index([institutionId, isActive])
  @@index([institutionId, name])
  @@map("subjects")
}

// Teacher Teaching Assignment (Penugasan Mengajar)
model TeacherAssignment {
  id              String         @id @default(cuid())
  institutionId   String
  teacherId       String         // Foreign key to User
  subjectId       String
  classroomId     String
  academicYearId  String
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  institution     Institution    @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  teacher         User           @relation(fields: [teacherId, institutionId], references: [id, institutionId], onDelete: Cascade)
  subject         Subject        @relation(fields: [subjectId, institutionId], references: [id, institutionId], onDelete: Cascade)
  academicYear    AcademicYear   @relation(fields: [academicYearId, institutionId], references: [id, institutionId], onDelete: Cascade)
  classroom       Classroom      @relation(fields: [classroomId, academicYearId, institutionId], references: [id, academicYearId, institutionId], onDelete: Cascade)
  attendanceSessions AttendanceSession[]
  assessments     Assessment[]

  @@unique([id, institutionId])
  @@unique([teacherId, subjectId, classroomId, academicYearId])
  @@index([institutionId, academicYearId, classroomId])
  @@index([institutionId, teacherId])
  @@index([institutionId, subjectId])
  @@map("teacher_assignments")
}

// -------------------------------------------------------------
// PHASE 3 — ATTENDANCE CORE
// -------------------------------------------------------------

// Attendance Session (Sesi Absensi Guru per Penugasan dan Tanggal / Asrama)
model AttendanceSession {
  id                  String             @id @default(cuid())
  institutionId       String
  teacherAssignmentId String?
  dormitoryRoomId     String?
  context             String             @default("ACADEMIC") // ACADEMIC | LIVING
  attendanceDate      DateTime           // Tanggal absensi akademik / asrama (UTC Date)
  status              String             @default("OPEN") // OPEN | CLOSED
  openedAt            DateTime           @default(now())
  closedAt            DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  institution         Institution        @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  teacherAssignment   TeacherAssignment? @relation(fields: [teacherAssignmentId, institutionId], references: [id, institutionId], onDelete: Cascade)
  dormitoryRoom       DormitoryRoom?     @relation(fields: [dormitoryRoomId, institutionId], references: [id, institutionId], onDelete: Cascade)
  records             AttendanceRecord[]

  @@unique([id, institutionId])
  @@unique([teacherAssignmentId, attendanceDate])
  @@unique([dormitoryRoomId, attendanceDate])
  @@index([institutionId, attendanceDate])
  @@index([institutionId, status])
  @@index([institutionId, context])
  @@index([institutionId, teacherAssignmentId])
  @@index([institutionId, dormitoryRoomId])
  @@map("attendance_sessions")
}

// Attendance Record (Rekaman Kehadiran Siswa Terikat Enrollment)
model AttendanceRecord {
  id                  String             @id @default(cuid())
  institutionId       String
  attendanceSessionId String
  studentId           String
  enrollmentId        String
  status              String             // PRESENT | EXCUSED | SICK | ABSENT
  note                String?
  markedAt            DateTime           @default(now())
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  institution         Institution        @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  session             AttendanceSession  @relation(fields: [attendanceSessionId, institutionId], references: [id, institutionId], onDelete: Cascade)
  student             Student            @relation(fields: [studentId, institutionId], references: [id, institutionId], onDelete: Cascade)
  enrollment          Enrollment         @relation(fields: [enrollmentId, institutionId], references: [id, institutionId], onDelete: Cascade)

  @@unique([id, institutionId])
  @@unique([attendanceSessionId, studentId])
  @@index([institutionId, attendanceSessionId])
  @@index([institutionId, studentId])
  @@index([institutionId, enrollmentId])
  @@index([institutionId, status])
  @@map("attendance_records")
}

// -------------------------------------------------------------
// PHASE 4 — COMMUNICATION ENGINE & NOTIFICATION OUTBOX
// -------------------------------------------------------------

model NotificationOutbox {
  id              String         @id @default(cuid())
  institutionId   String
  channel         String         @default("WHATSAPP") // WHATSAPP | EMAIL | SMS
  recipient       String         // Phone number / WA destination (e.g. "628123456789")
  templateKey     String         // PAYMENT_RECEIPT | ATTENDANCE_ALERT | GUARDIAN_INVITE | ANNOUNCEMENT
  payloadJson     String         // Event variables payload (JSON string)
  status          String         @default("PENDING") // PENDING | PROCESSING | DELIVERED | FAILED | CANCELLED
  attempts        Int            @default(0)
  maxAttempts     Int            @default(5)
  lastAttemptAt   DateTime?
  nextRetryAt     DateTime?
  errorMessage    String?
  providerId      String?        // "fonnte" | "waha" | "deeplink"
  externalId      String?        // Gateway message reference ID
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  institution     Institution    @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  @@unique([id, institutionId])
  @@index([institutionId, status])
  @@index([institutionId, nextRetryAt])
  @@index([institutionId, recipient])
  @@map("notification_outbox")
}

// -------------------------------------------------------------
// PHASE 4 — FINANCE CORE MODELS
// -------------------------------------------------------------

// Master Fee Category (Kategori Biaya / Syahriah Lembaga)
model FeeCategory {
  id              String          @id @default(cuid())
  institutionId   String
  code            String          // e.g. "SPP", "PANGKAL", "SERAGAM"
  name            String          // e.g. "SPP Syahriah Bulanan"
  description     String?
  amount          Float           // Nominal acuan master
  frequency       String          @default("MONTHLY") // ONE_TIME | MONTHLY | ANNUAL | CUSTOM
  isActive        Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  institution     Institution     @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  charges         StudentCharge[]

  @@unique([id, institutionId])
  @@unique([institutionId, code])
  @@index([institutionId, isActive])
  @@map("fee_categories")
}

// Student Charge (Kewajiban Tagihan Siswa - Snapshot Nominal)
model StudentCharge {
  id              String              @id @default(cuid())
  institutionId   String
  studentId       String
  feeCategoryId   String
  academicYearId  String?
  period          String?             // e.g. "2026-09"
  dueDate         DateTime?
  amount          Float               // Nominal snapshot saat tagihan terbit
  status          String              @default("UNPAID") // UNPAID | PARTIAL | PAID | VOID
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  institution     Institution         @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  student         Student             @relation(fields: [studentId, institutionId], references: [id, institutionId], onDelete: Cascade)
  feeCategory     FeeCategory         @relation(fields: [feeCategoryId, institutionId], references: [id, institutionId], onDelete: Cascade)
  academicYear    AcademicYear?       @relation(fields: [academicYearId, institutionId], references: [id, institutionId], onDelete: Restrict)
  allocations     PaymentAllocation[]

  @@unique([id, institutionId])
  @@index([institutionId, studentId])
  @@index([institutionId, status])
  @@index([institutionId, period])
  @@map("student_charges")
}

// Payment Transaction (Penerimaan Kas Pembayaran dari Siswa)
model PaymentTransaction {
  id                String              @id @default(cuid())
  institutionId     String
  studentId         String
  transactionNumber String              // e.g. "TRX-202609-000001"
  paymentDate       DateTime            @default(now())
  amount            Float               // Total pembayaran yang diterima
  paymentMethod     String              @default("CASH") // CASH | TRANSFER | OTHER
  note              String?
  receivedById      String
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  institution       Institution         @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  student           Student             @relation(fields: [studentId, institutionId], references: [id, institutionId], onDelete: Cascade)
  receivedBy        User                @relation(fields: [receivedById, institutionId], references: [id, institutionId], onDelete: Cascade)
  allocations       PaymentAllocation[]
  receipt           Receipt?
  cashbookEntry     CashbookEntry?

  @@unique([id, institutionId])
  @@unique([institutionId, transactionNumber])
  @@index([institutionId, studentId])
  @@index([institutionId, paymentDate])
  @@map("payment_transactions")
}

// Payment Allocation (Alokasi Pembayaran ke Spesifik Tagihan)
model PaymentAllocation {
  id                   String             @id @default(cuid())
  institutionId        String
  paymentTransactionId String
  studentChargeId      String
  amount               Float              // Nominal yang dialokasikan
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  institution          Institution        @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  paymentTransaction   PaymentTransaction @relation(fields: [paymentTransactionId, institutionId], references: [id, institutionId], onDelete: Cascade)
  studentCharge        StudentCharge      @relation(fields: [studentChargeId, institutionId], references: [id, institutionId], onDelete: Cascade)

  @@unique([id, institutionId])
  @@index([institutionId, paymentTransactionId])
  @@index([institutionId, studentChargeId])
  @@map("payment_allocations")
}

// Cashbook Entry (Buku Kas Umum Lembaga - Pergerakan Kas)
model CashbookEntry {
  id                   String              @id @default(cuid())
  institutionId        String
  entryNumber          String              // e.g. "CSH-202609-000001"
  entryDate            DateTime            @default(now())
  type                 String              // INCOME | EXPENSE
  amount               Float
  paymentTransactionId String?             @unique
  description          String
  createdById          String
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  institution          Institution         @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  paymentTransaction   PaymentTransaction? @relation(fields: [paymentTransactionId, institutionId], references: [id, institutionId], onDelete: Restrict)
  createdBy            User                @relation(fields: [createdById, institutionId], references: [id, institutionId], onDelete: Cascade)

  @@unique([id, institutionId])
  @@unique([institutionId, entryNumber])
  @@unique([paymentTransactionId, institutionId])
  @@index([institutionId, entryDate])
  @@index([institutionId, type])
  @@map("cashbook_entries")
}

// Receipt (Kwitansi Bukti Pembayaran Sah)
model Receipt {
  id                   String              @id @default(cuid())
  institutionId        String
  paymentTransactionId String              @unique
  receiptNumber        String              // e.g. "KW-202609-000001"
  issuedAt             DateTime            @default(now())
  issuedById           String
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  institution          Institution         @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  paymentTransaction   PaymentTransaction  @relation(fields: [paymentTransactionId, institutionId], references: [id, institutionId], onDelete: Cascade)
  issuedBy             User                @relation(fields: [issuedById, institutionId], references: [id, institutionId], onDelete: Cascade)

  @@unique([id, institutionId])
  @@unique([institutionId, receiptNumber])
  @@unique([paymentTransactionId, institutionId])
  @@index([institutionId, issuedAt])
  @@map("receipts")
}

// -------------------------------------------------------------
// PHASE 5 — FORMAL ACADEMIC CORE (ASSESSMENT, GRADES & RAPORT)
// -------------------------------------------------------------

// Assessment (Rencana & Pelaksanaan Penilaian Akademik Guru)
model Assessment {
  id                  String             @id @default(cuid())
  institutionId       String
  teacherAssignmentId String
  title               String             // e.g. "Ulangan Harian Bab 1", "UTS Semester Ganjil"
  type                String             // DAILY | QUIZ | MIDTERM | FINAL | PROJECT | OTHER
  assessmentDate      DateTime
  maxScore            Float              @default(100)
  isPublished         Boolean            @default(false)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  institution         Institution        @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  teacherAssignment   TeacherAssignment  @relation(fields: [teacherAssignmentId, institutionId], references: [id, institutionId], onDelete: Cascade)
  scores              AssessmentScore[]

  @@unique([id, institutionId])
  @@index([institutionId, teacherAssignmentId])
  @@index([institutionId, type])
  @@map("assessments")
}

// Assessment Score (Nilai Penilaian per Siswa & Enrollment)
model AssessmentScore {
  id                  String             @id @default(cuid())
  institutionId       String
  assessmentId        String
  studentId           String
  enrollmentId        String
  score               Float              // >= 0 and <= assessment.maxScore
  note                String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  institution         Institution        @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  assessment          Assessment         @relation(fields: [assessmentId, institutionId], references: [id, institutionId], onDelete: Cascade)
  student             Student            @relation(fields: [studentId, institutionId], references: [id, institutionId], onDelete: Cascade)
  enrollment          Enrollment         @relation(fields: [enrollmentId, institutionId], references: [id, institutionId], onDelete: Cascade)

  @@unique([id, institutionId])
  @@unique([assessmentId, studentId])
  @@index([institutionId, assessmentId])
  @@index([institutionId, studentId])
  @@index([institutionId, enrollmentId])
  @@map("assessment_scores")
}

// Report Card (Buku Raport Siswa & Snapshot Hasil Belajar)
model ReportCard {
  id                  String              @id @default(cuid())
  institutionId       String
  studentId           String
  enrollmentId        String
  academicYearId      String
  classroomId         String
  semester            String              // ODD | EVEN
  status              String              @default("DRAFT") // DRAFT | PUBLISHED
  publishedAt         DateTime?
  publishedById       String?
  notes               String?
  frozenData          String?             // JSON snapshot abadi saat PUBLISHED
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  institution         Institution         @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  student             Student             @relation(fields: [studentId, institutionId], references: [id, institutionId], onDelete: Cascade)
  enrollment          Enrollment          @relation(fields: [enrollmentId, institutionId], references: [id, institutionId], onDelete: Cascade)
  academicYear        AcademicYear        @relation(fields: [academicYearId, institutionId], references: [id, institutionId], onDelete: Cascade)
  classroom           Classroom           @relation(fields: [classroomId, academicYearId, institutionId], references: [id, academicYearId, institutionId], onDelete: Cascade)
  publishedBy         User?               @relation(fields: [publishedById, institutionId], references: [id, institutionId], onDelete: Restrict)
  subjects            ReportCardSubject[]

  @@unique([id, institutionId])
  @@unique([enrollmentId, semester])
  @@index([institutionId, studentId])
  @@index([institutionId, academicYearId, classroomId])
  @@index([institutionId, status])
  @@map("report_cards")
}

// Report Card Subject (Nilai Akhir per Mata Pelajaran dalam Raport)
model ReportCardSubject {
  id                  String             @id @default(cuid())
  institutionId       String
  reportCardId        String
  subjectId           String
  finalScore          Float
  letterGrade         String?            // A | B | C | D
  comments            String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  institution         Institution        @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  reportCard          ReportCard         @relation(fields: [reportCardId, institutionId], references: [id, institutionId], onDelete: Cascade)
  subject             Subject            @relation(fields: [subjectId, institutionId], references: [id, institutionId], onDelete: Cascade)

  @@unique([id, institutionId])
  @@unique([reportCardId, subjectId])
  @@index([institutionId, reportCardId])
  @@index([institutionId, subjectId])
  @@map("report_card_subjects")
}

// -------------------------------------------------------------
// PHASE 6 — PESANTREN & TAHFIDZ LIVING CORE
// -------------------------------------------------------------

// Tahfidz Mutaba'ah Record
model TahfidzRecord {
  id              String         @id @default(cuid())
  institutionId   String
  studentId       String
  enrollmentId    String
  date            DateTime       // Tanggal setoran/muraja'ah (UTC Date)
  surah           Int            // Nomor Surah (1 - 114)
  surahName       String?        // Nama surah, e.g. "Al-Baqarah"
  startAyah       Int            // Ayat awal (>= 1)
  endAyah         Int            // Ayat akhir (>= startAyah)
  type            String         // SETORAN | MURAJAAH
  quality         String         // MUMTAZ | JAYYID | MAQBUL | REPEAT
  note            String?
  recordedBy      String         // User ID (Ustadz / Penguji)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  institution     Institution    @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  student         Student        @relation(fields: [studentId, institutionId], references: [id, institutionId], onDelete: Cascade)
  enrollment      Enrollment     @relation(fields: [enrollmentId, institutionId], references: [id, institutionId], onDelete: Cascade)
  recorder        User           @relation(fields: [recordedBy, institutionId], references: [id, institutionId], onDelete: Cascade)

  @@unique([id, institutionId])
  @@index([institutionId, studentId])
  @@index([institutionId, enrollmentId])
  @@index([institutionId, date])
  @@index([institutionId, type])
  @@map("tahfidz_records")
}

// Gedung / Kompleks Asrama Santri
model Dormitory {
  id              String         @id @default(cuid())
  institutionId   String
  name            String         // e.g. "Gedung Abu Bakar Ash-Shiddiq"
  gender          String?        // L | P
  description     String?
  isActive        Boolean        @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  institution     Institution    @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  rooms           DormitoryRoom[]

  @@unique([id, institutionId])
  @@unique([institutionId, name])
  @@index([institutionId, isActive])
  @@map("dormitories")
}

// Kamar / Kobong Asrama Santri
model DormitoryRoom {
  id              String         @id @default(cuid())
  institutionId   String
  dormitoryId     String
  name            String         // e.g. "Kamar 101"
  capacity        Int            // Kapasitas maksimum santri
  isActive        Boolean        @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  institution     Institution    @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  dormitory       Dormitory      @relation(fields: [dormitoryId, institutionId], references: [id, institutionId], onDelete: Cascade)
  assignments     StudentDormitoryAssignment[]
  attendanceSessions AttendanceSession[]

  @@unique([id, institutionId])
  @@unique([dormitoryId, name])
  @@index([institutionId, dormitoryId])
  @@index([institutionId, isActive])
  @@map("dormitory_rooms")
}

// Penempatan Santri di Kamar Asrama (Historical Sacred History)
model StudentDormitoryAssignment {
  id              String         @id @default(cuid())
  institutionId   String
  studentId       String
  roomId          String
  startDate       DateTime       @default(now())
  endDate         DateTime?
  status          String         @default("ACTIVE") // ACTIVE | ENDED | MOVED
  notes           String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  institution     Institution    @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  student         Student        @relation(fields: [studentId, institutionId], references: [id, institutionId], onDelete: Cascade)
  room            DormitoryRoom  @relation(fields: [roomId, institutionId], references: [id, institutionId], onDelete: Cascade)

  @@unique([id, institutionId])
  @@index([institutionId, studentId, status])
  @@index([institutionId, roomId, status])
  @@map("student_dormitory_assignments")
}





